# Copy to apps/mobile/.env (git-ignored). Only these three PUBLIC values belong in the app.
# Never put a secret key, a service-role key or a database URL here: EXPO_PUBLIC_* values
# are compiled into the app bundle and anyone can read them.
#
# Expo loads apps/mobile/.env when Metro starts (`npx nx start mobile`) and inlines the
# EXPO_PUBLIC_* values; restart Metro (with --clear) if a change is not picked up.

# Local Supabase (`npx nx supabase-start api`), reached over the Mac's LAN IP so a phone can
# reach it. Plain http is fine for local testing; use https for anything deployed.
EXPO_PUBLIC_SUPABASE_URL=http://<LAN-IP>:54321

# The API from `npx nx serve api`, with its /api prefix.
EXPO_PUBLIC_API_URL=http://<LAN-IP>:3000/api

# The publishable key (sb_publishable_...) printed by `npx supabase status` in apps/api.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<local-key>
