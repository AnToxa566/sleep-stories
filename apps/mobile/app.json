{
  "expo": {
    "name": "Sleep Stories",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antoxa566.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#09070F"
      },
      "package": "com.antoxa566.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09070F"
        }
      ]
    ],
    "backgroundColor": "#09070F",
    "extra": {
      "eas": {
        "projectId": "a9ad787d-027a-4e03-986a-254f2c1670a4"
      }
    },
    "owner": "antoxa-org"
  }
}
