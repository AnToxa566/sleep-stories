# Copy to apps/api/.env (git-ignored) and fill in real values. Placeholders only here.

# Runtime connection used by the running API: Supabase transaction pooler (port 6543).
# Do not add ?pgbouncer=true; the Prisma pg adapter does not use it.
# TLS is configured in code (pinned Supabase root CA). Do not put sslmode or any
# ssl* parameter in this URL: the API refuses to start if it finds one.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"

# Used only by the Prisma CLI (migrate): Supabase session pooler (port 5432).
# `prisma generate` does not connect, but it needs this variable to be set.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
