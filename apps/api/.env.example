# Copy to apps/api/.env (git-ignored) and fill in real values. Placeholders only for the cloud project.
# Local development is the default: the "local" block is active and the cloud lines are
# commented out with the prefix "# cloud: ". To use the cloud project, comment out the local
# block, remove that prefix from the two cloud lines and fill in the real values. Exactly one
# definition of DATABASE_URL and of DIRECT_URL may be active. Switch back afterwards.

# --- Local Supabase stack (npx nx supabase-start api) ---
# These values are the public defaults of the Supabase CLI, not secrets. The CLI publishes
# its ports (54321 to 54324) on all network interfaces, so stop the stack after work.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Plaintext database connections are allowed only
# when DATABASE_TLS=disabled-local-only AND the database host is loopback AND the process is
# not on Cloud Run or in production. In every other case the API refuses to start.
DATABASE_TLS=disabled-local-only
# The Supabase project URL: the API verifies access tokens against the keys and issuer found here.
SUPABASE_URL="http://127.0.0.1:54321"
# Server-only. The service-role key of the Supabase project: it bypasses RLS, so it must never
# reach the mobile app, logs or a commit. The API uses it only to sign audio URLs. Locally, copy
# the "Secret" key from `npx nx supabase-status api --outputStyle=static` into your own .env;
# never paste it anywhere else. In the cloud it comes from Secret Manager.
SUPABASE_SERVICE_ROLE_KEY="<service-role-or-secret-key>"
# Server-only. Provider keys for story generation (Anthropic for text, ElevenLabs for voice). They
# cost money per call, so they must never reach the mobile app, logs, prompts or a commit. The API
# will not boot until both are set. In the cloud they come from Secret Manager.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-api-key
# Optional model ids. Defaults: claude-haiku-5-5 and eleven_v4. Both worked in the paid smoke
# test on 2026-10-30 (ElevenLabs text-to-speech through the API needs a paid plan).
# ANTHROPIC_MODEL=claude-haiku-5-5
# ELEVENLABS_MODEL=eleven_v4
# The one private Storage bucket for audio. Optional, default "audio". Database paths
# (voices/<slug>/sample.mp3) are relative to it. The local stack creates it from config.toml.
# AUDIO_BUCKET="audio"
# Optional, LOCAL DEVELOPMENT ONLY (refused at boot on Cloud Run and when NODE_ENV is production).
# The local stack signs audio URLs with the host of SUPABASE_URL (127.0.0.1), which a phone cannot
# reach. Set this to the origin the phone can reach (the Mac's LAN address and the stack's API
# port, no path); the API swaps it into every signed URL. Leave it unset in production.
# STORAGE_PUBLIC_URL="http://192.168.1.20:54321"

# --- Cloud Supabase project ---
# Runtime connection used by the running API: Supabase transaction pooler (port 6543).
# Do not add ?pgbouncer=true; the Prisma pg adapter does not use it.
# TLS is configured in code (pinned Supabase root CA). Do not put sslmode or any
# ssl* parameter in this URL: the API refuses to start if it finds one.
# cloud: DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"

# Used only by the Prisma CLI (migrate): Supabase session pooler (port 5432).
# `prisma generate` does not connect, but it needs this variable to be set.
# cloud: DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
