# Copy to apps/api/.env (git-ignored) and fill in real values. Placeholders only for the cloud project.
# Local development is the default: the "local" block is active and the cloud lines are
# commented out with the prefix "# cloud: ". To use the cloud project, comment out the local
# block, remove that prefix from the two cloud lines and fill in the real values. Exactly one
# definition of DATABASE_URL and of DIRECT_URL may be active. Switch back afterwards.

# --- Local Supabase stack (npx nx supabase-start api) ---
# These values are the public defaults of the Supabase CLI, not secrets. The CLI publishes
# its ports (54321 to 54324) on all network interfaces, so stop the stack after work.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Plaintext database connections are allowed only
# when DATABASE_TLS=disabled-local-only AND the database host is loopback AND the process is
# not on Cloud Run or in production. In every other case the API refuses to start.
DATABASE_TLS=disabled-local-only
# The Supabase project URL: the API verifies access tokens against the keys and issuer found here.
SUPABASE_URL="http://127.0.0.1:54321"

# --- Cloud Supabase project ---
# Runtime connection used by the running API: Supabase transaction pooler (port 6543).
# Do not add ?pgbouncer=true; the Prisma pg adapter does not use it.
# TLS is configured in code (pinned Supabase root CA). Do not put sslmode or any
# ssl* parameter in this URL: the API refuses to start if it finds one.
# cloud: DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"

# Used only by the Prisma CLI (migrate): Supabase session pooler (port 5432).
# `prisma generate` does not connect, but it needs this variable to be set.
# cloud: DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
