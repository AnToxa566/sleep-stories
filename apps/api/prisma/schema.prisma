// Prisma schema for Sleep Stories. See ARCHITECTURE.md section 5 for the reasoning.
//
// Conventions:
// - Models are PascalCase singular, fields camelCase; tables and columns are
//   snake_case through @@map / @map.
// - Primary keys are uuid with a database default of gen_random_uuid(), except
//   users.id, which is the Supabase auth user id (plain uuid, no foreign key
//   into the auth schema).
// - Timestamps are timestamptz(3).
// - Every relation states onDelete explicitly. users is the cascade anchor.
// - Things Prisma cannot express (RLS, CHECK constraints, the partial unique
//   index on generation_jobs.dedupe_key) are appended as raw SQL to the init
//   migration.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StoryStyle {
  facts
  fairy_tale
  history

  @@map("story_style")
}

enum TopicReason {
  proposed
  requested

  @@map("topic_reason")
}

enum JobKind {
  suggest_topics
  write_story
  render_audio

  @@map("job_kind")
}

enum JobStatus {
  pending
  running
  succeeded
  failed

  @@map("job_status")
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

model Voice {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                  String   @unique
  name                  String
  description           String
  ttsProvider           String   @map("tts_provider")
  providerVoiceId       String   @map("provider_voice_id")
  sampleAudioPath       String   @map("sample_audio_path")
  asleepPromptAudioPath String   @map("asleep_prompt_audio_path")
  sortOrder             Int      @default(0) @map("sort_order")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  preferences UserPreference[]
  storyAudio  StoryAudio[]
  listens     Listen[]

  @@map("voices")
}

model Interest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  title     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userInterests UserInterest[]
  topics        Topic[]

  @@map("interests")
}

// ---------------------------------------------------------------------------
// Users and per-user state
// ---------------------------------------------------------------------------

// id equals the Supabase auth user id. No default and no foreign key into the
// auth schema. Every per-user table cascades from here.
model User {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  preferences     UserPreference?
  interests       UserInterest[]
  customInterests UserCustomInterest[]
  topics          UserTopic[]
  queueItems      QueueItem[]
  listens         Listen[]
  ratings         StoryRating[]
  requestedJobs   GenerationJob[]

  @@map("users")
}

// One row per user, created when onboarding finishes.
// CHECK (styles has at least one element) is added as raw SQL.
model UserPreference {
  userId    String       @id @map("user_id") @db.Uuid
  voiceId   String       @map("voice_id") @db.Uuid
  styles    StoryStyle[]
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  voice Voice @relation(fields: [voiceId], references: [id], onDelete: Restrict)

  @@map("user_preferences")
}

model UserInterest {
  userId     String   @map("user_id") @db.Uuid
  interestId String   @map("interest_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Restrict)

  @@id([userId, interestId])
  @@map("user_interests")
}

// CHECK (title is not blank) is added as raw SQL.
model UserCustomInterest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_custom_interests")
}

// ---------------------------------------------------------------------------
// Story content (user-independent, no owner column)
// ---------------------------------------------------------------------------

model Topic {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  style      StoryStyle
  interestId String?    @map("interest_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  interest   Interest?   @relation(fields: [interestId], references: [id], onDelete: Restrict)
  story      Story?
  userTopics UserTopic[]
  queueItems QueueItem[]

  @@index([interestId])
  @@map("topics")
}

// A story row exists only when the text is complete. CHECK (char_count > 0) is raw SQL.
model Story {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId       String   @unique @map("topic_id") @db.Uuid
  text          String
  charCount     Int      @map("char_count")
  llmModel      String   @map("llm_model")
  promptVersion String   @map("prompt_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  topic   Topic         @relation(fields: [topicId], references: [id], onDelete: Restrict)
  audio   StoryAudio[]
  listens Listen[]
  ratings StoryRating[]

  @@map("stories")
}

// One audio file per (story, voice). storagePath is an object path, never a URL.
// CHECKs (duration_sec > 0, byte_size > 0) are raw SQL.
model StoryAudio {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storyId     String   @map("story_id") @db.Uuid
  voiceId     String   @map("voice_id") @db.Uuid
  storagePath String   @unique @map("storage_path")
  durationSec Int      @map("duration_sec")
  byteSize    Int      @map("byte_size")
  mimeType    String   @map("mime_type")
  ttsProvider String   @map("tts_provider")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  story Story @relation(fields: [storyId], references: [id], onDelete: Restrict)
  voice Voice @relation(fields: [voiceId], references: [id], onDelete: Restrict)

  @@unique([storyId, voiceId])
  @@map("story_audio")
}

// ---------------------------------------------------------------------------
// Per-user state that references content
// ---------------------------------------------------------------------------

// Which topics a user was offered or asked for. dismissedAt records "not interested".
model UserTopic {
  userId      String      @map("user_id") @db.Uuid
  topicId     String      @map("topic_id") @db.Uuid
  reason      TopicReason
  dismissedAt DateTime?   @map("dismissed_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([userId, topicId])
  @@map("user_topics")
}

// The queue references topics, not stories, so a topic can be queued before its
// story exists. No unique constraint on position: reordering rewrites positions
// in one transaction without tripping over a transient duplicate.
model QueueItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@unique([userId, topicId])
  @@index([userId, position])
  @@map("queue_items")
}

// One row per listening session. The outcome (finished or skipped) is derived
// from listenedSec and the audio duration and is never stored.
// listenedAt has no database default: the value comes from the client event.
// CHECK (listened_sec >= 0) is raw SQL.
model Listen {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  storyId     String   @map("story_id") @db.Uuid
  voiceId     String   @map("voice_id") @db.Uuid
  listenedSec Int      @map("listened_sec")
  listenedAt  DateTime @map("listened_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Restrict)
  voice Voice @relation(fields: [voiceId], references: [id], onDelete: Restrict)

  @@index([userId, listenedAt(sort: Desc)])
  @@map("listens")
}

// CHECK (rating IN (-1, 1)) is raw SQL.
model StoryRating {
  userId    String   @map("user_id") @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  rating    Int      @db.SmallInt
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Restrict)

  @@id([userId, storyId])
  @@map("story_ratings")
}

// ---------------------------------------------------------------------------
// System state
// ---------------------------------------------------------------------------

// Generation health, kept apart from anything the user chose. The partial unique
// index on dedupe_key (WHERE status IN ('pending','running')) is raw SQL; it lets
// a finished job and a new one share a key but never two active ones.
model GenerationJob {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind              JobKind
  payload           Json
  dedupeKey         String    @map("dedupe_key")
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  status            JobStatus @default(pending)
  attempts          Int       @default(0)
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt         DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(3)

  requestedBy User? @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([requestedByUserId, createdAt])
  @@map("generation_jobs")
}
